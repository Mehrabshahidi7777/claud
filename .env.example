APP_NAME="پیگیر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Create the database by hand before migrating, with utf8mb4 — the default
# collation on some MySQL installs mangles Persian text and emoji:
#   CREATE DATABASE sazmat CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sazmat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# The weekly report goes out by email AND by SMS, because deliverability to
# Iranian inboxes is unreliable enough that email alone loses half the readers.
MAIL_FROM_ADDRESS=report@example.ir
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SMS (AmootSMS, dedicated line) -----------------------------------------
# The dedicated line only accepts pattern-based sends, so each template below
# must be registered and approved in the panel before it will deliver.
# Keep this on "log" until that is done; "amoot" spends real credit.
SMS_DRIVER=log
SMS_ENABLED=true

AMOOT_BASE_URL=https://portal.amootsms.com/rest
AMOOT_TOKEN=
AMOOT_LINE_NUMBER=
AMOOT_TIMEOUT=15

# Shared secret the inbound webhook must present. Generate with:
#   php -r "echo bin2hex(random_bytes(24));"
AMOOT_INBOUND_SECRET=

# Pattern codes from the panel, one per template. The approved wording for
# each is in config/sms.php — register exactly that text, then paste the code
# the panel gives back here.
#
# A pattern with no code here is refused before any request goes out, and the
# engine treats it as an undelivered message rather than a silent success. So
# you can register them one at a time. OTP is the only one sign-in needs.
AMOOT_PATTERN_OTP=
AMOOT_PATTERN_CHASE=
AMOOT_PATTERN_DEFER_ASK=
AMOOT_PATTERN_ESCALATE=
AMOOT_PATTERN_CONFIRM_DONE=
AMOOT_PATTERN_CONFIRM_DEFER=
AMOOT_PATTERN_UNKNOWN=
AMOOT_PATTERN_WELCOME=
AMOOT_PATTERN_WEEKLY_REPORT=
AMOOT_PATTERN_SUBSCRIPTION_EXPIRING=
AMOOT_PATTERN_APPROVAL_REQUEST=
AMOOT_PATTERN_APPROVAL_DECISION=

# --- Payment (SEP / Saman) --------------------------------------------------
# "fake" moves no money and completes every payment, which is what the demo
# and the tests run on. Switch to "sep" only once the terminal is live.
PAYMENT_GATEWAY=fake
SEP_TERMINAL_ID=

# In the Saman panel, register the callback as:
#   https://<your-domain>/billing/callback
# The callback is never proof of payment on its own — nothing is marked paid
# until the server-to-server verify agrees on both the reference AND the
# amount. Leave the three URLs below unless Saman tells you otherwise.
# SEP_TOKEN_URL=https://sep.shaparak.ir/onlinepg/onlinepg
# SEP_PAYMENT_URL=https://sep.shaparak.ir/OnlinePG/OnlinePG
# SEP_VERIFY_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction
# SEP_CONNECT_TIMEOUT=5
# SEP_TOKEN_TIMEOUT=15
# SEP_VERIFY_TIMEOUT=30

VAT_PERCENT=10
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7

# --- Local AI (Ollama) ------------------------------------------------------
# Leave AI_PROVIDER=null and everything still works: free-text capture falls
# back to the manual form and the weekly report writes itself from the numbers.
# Set it to "ollama" once a model is pulled on the server.
AI_PROVIDER=null
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Two jobs, two models. Extraction turns a paragraph into tasks and wants
# schema obedience and speed; writing composes the weekly report's opening
# paragraph and wants readable Persian. On a small VPS set both the same.
#   ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL_EXTRACTION=qwen2.5:7b-instruct
OLLAMA_MODEL_WRITING=qwen2.5:14b-instruct

OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m
AI_DAILY_PARSE_LIMIT=50

# --- Finance ----------------------------------------------------------------
# Days past an invoice's due date before it becomes a task somebody is chased
# about. Not zero: an invoice a day late is usually a payment already in
# flight, and chasing it costs goodwill with the customer.
FINANCE_CHASE_AFTER_DAYS=3

# Days an approved purchase has to get a receipt filed against it before the
# reconciliation view reports it as unaccounted for.
FINANCE_RECONCILE_AFTER_DAYS=14
