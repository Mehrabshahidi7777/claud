APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SMS (AmootSMS, dedicated line) -----------------------------------------
# The dedicated line only accepts pattern-based sends, so each template below
# must be registered and approved in the panel before it will deliver.
# Keep this on "log" until that is done; "amoot" spends real credit.
SMS_DRIVER=log
SMS_ENABLED=true

AMOOT_BASE_URL=https://portal.amootsms.com/rest
AMOOT_TOKEN=
AMOOT_LINE_NUMBER=
AMOOT_TIMEOUT=15

# Shared secret the inbound webhook must present. Generate with:
#   php -r "echo bin2hex(random_bytes(24));"
AMOOT_INBOUND_SECRET=

# Pattern codes from the panel, one per template.
AMOOT_PATTERN_CHASE=
AMOOT_PATTERN_DEFER_ASK=
AMOOT_PATTERN_ESCALATE=
AMOOT_PATTERN_CONFIRM_DONE=
AMOOT_PATTERN_CONFIRM_DEFER=
AMOOT_PATTERN_UNKNOWN=
AMOOT_PATTERN_OTP=
AMOOT_PATTERN_WELCOME=

# --- Payment (SEP / Saman) --------------------------------------------------
# Not wired up yet: the demo slice invoices by hand. These are here so phase 2
# is a matter of writing the driver rather than rewiring configuration.
PAYMENT_DRIVER=sep
SEP_TERMINAL_ID=
SEP_CALLBACK_URL=
